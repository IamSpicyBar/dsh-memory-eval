{
  "name": "dsh-memory-eval",
  "version": "0.4.0",
  "description": "Self-contained Memory L1/L2 validation and optional core-executor L3 verification",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/IamSpicyBar/dsh-memory-eval.git"
  },
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "evaluate.py",
    "backend.py",
    "model_client.py",
    "memory_format.py",
    "l1.py",
    "l3.py",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "bin/eval.mjs",
    "capabilities.json"
  ],
  "bin": {
    "memory-eval": "bin/eval.mjs"
  },
  "engines": {
    "node": ">=24.9",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'"
  }
}
